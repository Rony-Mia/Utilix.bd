# PORT: Port the Express server listens on (default: 3000).
PORT="3000"

# NODE_ENV: Set to "production" to serve the prerendered build from dist/.
NODE_ENV="development"

# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET: GitHub OAuth App credentials used
# by /api/auth and /api/callback (api/auth.ts, api/callback.ts on Vercel) to
# let Decap CMS (/admin) log in and commit content changes via the GitHub
# API. Create an OAuth App at https://github.com/settings/developers with
# Authorization callback URL = https://utools.bd/api/callback, then set
# these two as Environment Variables in Vercel Project Settings (not in this
# file for production — .env is for local `npm run dev` only).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ADMIN_GATE_USER / ADMIN_GATE_PASS / ADMIN_GATE_TOKEN: an independent
# password layer in front of /admin (middleware.ts), separate from GitHub
# OAuth above. Pick your own values:
#   ADMIN_GATE_USER / ADMIN_GATE_PASS — the username/password shown on the
#     custom login form at /admin.
#   ADMIN_GATE_TOKEN — a random secret string (not shown to anyone; e.g. run
#     `openssl rand -hex 24`) stored in the session cookie after a
#     successful login, so the cookie itself never contains the password.
# If ADMIN_GATE_TOKEN is unset, this gate is skipped entirely (fails open)
# so the owner is never locked out before configuring it.
ADMIN_GATE_USER=""
ADMIN_GATE_PASS=""
ADMIN_GATE_TOKEN=""
